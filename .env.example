# ==============================================================================
# Crime Data Analytics and Visualization System - Environment Configuration
# ==============================================================================

# Flask Secret Key (Generate a random secure key for production)
SECRET_KEY=dev_secret_key_crime_analytics_2026

# Database Configuration
# Supported types: 'sqlite' (default, zero-configuration) or 'mysql'
DB_TYPE=sqlite

# MySQL Connection Details (Required only if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=crime_analytics

# Initial Admin User Credentials (Seeded on first startup if not exists)
ADMIN_EMAIL=admin@crime.local
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=change_this_admin_password_123

# Server Port (Optional: Defaults to 5000 if not specified)
PORT=5000

# Power BI Embedded Dashboard URL (Optional: Leave blank for native embedded engine)
POWERBI_EMBED_URL=
